# QROS Control Center v1 — Environment Variables (Stage 1: structure only)
# Copy to .env and fill. Never commit .env. See SECURITY.md.
# All values are placeholders — replace with real secrets via env or secret manager.

# ── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
# Options: debug, info, warn, error
TZ=Asia/Tashkent

# ── Telegram ────────────────────────────────────────────────────────────────
# Create via @BotFather, keep token secret. Align with AGENT_PROTOCOL § Telegram: Git-only, no Telegram bus for AgentOS — ControlCenter Bot is separate mgmt plane.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Comma-separated Telegram user IDs allowed to use the bot (no @usernames). Empty = deny all.
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Optional: webhook mode (leave empty for long-polling). Must be https://<public-host>/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Telegram API base (default https://api.telegram.org)
TELEGRAM_API_URL=https://api.telegram.org

# ── OpenAI Gateway ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...replace...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.2
# Gateway bind port inside compose network
GATEWAY_PORT=8080
# Gateway upstream timeouts
GATEWAY_TIMEOUT_SECONDS=30
# Rate limit (requests per minute per user)
GATEWAY_RATE_LIMIT_RPM=20

# ── GitHub ─────────────────────────────────────────────────────────────────
# PAT with minimal scopes: repo (read/write), workflow (if triggering CI), admin:repo_hook (if creating webhook programmatically). Prefer fine-grained PAT limited to masudbek001-droid/QuantResearchOS.
GITHUB_TOKEN=ghp_...replace...
GITHUB_REPO=masudbek001-droid/QuantResearchOS
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=replace-with-random-32+chars-hex
GITHUB_WEBHOOK_PORT=8082
# Branch this control center manages (arena branch as per mission)
GITHUB_ARENA_BRANCH=arena/01a0a3b5-quantresearchos
GITHUB_DEFAULT_BRANCH=main

# ── Bot ────────────────────────────────────────────────────────────────────
BOT_PORT=8081
BOT_POLL_INTERVAL_SECONDS=1
# How Bot reaches Gateway inside Docker network
GATEWAY_INTERNAL_URL=http://gateway:8080
# How Watcher reaches Bot/Gateway
BOT_INTERNAL_URL=http://bot:8081

# ── GithubWatcher ───────────────────────────────────────────────────────────
WATCHER_PORT=8082
# Public URL GitHub will POST to (must be reachable; use ngrok/cloudflare tunnel for dev)
WATCHER_PUBLIC_URL=https://example.com/github/webhook
WATCHER_INTERNAL_URL=http://github-watcher:8082

# ── Control Center (orchestrator UI placeholder, Stage 1: docs only) ───────
CONTROL_CENTER_PORT=8083

# ── AgentOS ────────────────────────────────────────────────────────────────
# Path inside container where repo is mounted (read-only except for queue ops via GitHub API)
AGENTOS_PATH=/app/AgentOS
# GitHub is source of truth; local AgentOS files are mirrors via API. No direct Telegram→AgentOS.
AGENTOS_POLL_INTERVAL_SECONDS=30

# ── Arena + Kilo (downstream, Stage 1 stub) ───────────────────────────────
# Arena is cloud workspace (this repo's arena branch). Kilo is local runner placeholder.
ARENA_URL=https://arena.example.com
KILO_URL=http://kilo:8000
KILO_TOKEN=

# ── Networking ─────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=qros-control-center
NETWORK_NAME=qros-control-net

# ── Optional Persistence (Stage 1: not required, placeholders) ─────────────
# REDIS_URL=redis://redis:6379/0
# DATABASE_URL=postgresql://qros:qros@postgres:5432/qros
