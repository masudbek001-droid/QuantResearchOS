{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOS Lock",
  "type": "object",
  "required": ["LockID", "Path", "Worker", "TaskID", "Acquired", "Expires", "Status"],
  "properties": {
    "LockID": { "type": "string", "pattern": "^LOCK-\\d{4}$" },
    "Path": { "type": "string", "minLength": 1 },
    "Worker": { "type": "string", "pattern": "^worker-[a-z0-9-]+$" },
    "TaskID": { "type": "string", "pattern": "^TASK-\\d{4}$" },
    "Acquired": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} UTC$" },
    "Expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} UTC$" },
    "Status": { "type": "string", "enum": ["ACTIVE","RELEASED","EXPIRED","DENIED"] }
  }
}
