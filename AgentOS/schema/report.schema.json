{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOS Report",
  "type": "object",
  "required": ["ReportID", "TaskID", "Worker", "Status", "Verdict", "Artifacts", "Timestamp"],
  "properties": {
    "ReportID": { "type": "string", "pattern": "^REPORT-\\d{4}$" },
    "TaskID": { "type": "string", "pattern": "^TASK-\\d{4}$" },
    "Worker": { "type": "string", "pattern": "^worker-[a-z0-9-]+$" },
    "Status": { "type": "string", "enum": ["PENDING","APPROVED","REJECTED","SUPERSEDED"] },
    "Verdict": { "type": "string", "enum": ["PASS","FAIL","BLOCKED","PARTIAL"] },
    "Artifacts": { "type": "string", "minLength": 1 },
    "Timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2} UTC$" }
  }
}
